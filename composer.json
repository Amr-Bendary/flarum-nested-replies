{
  "name": "itqan/flarum-nested-replies",
  "description": "Restyle Flarum discussions as Reddit-style nested reply threads.",
  "keywords": ["flarum", "theme", "reddit", "nested", "threads"],
  "license": "MIT",
  "type": "flarum-extension",
  "require": {
    "flarum/core": "^1.8 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "Itqan\\NestedReplies\\": "src/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "Nested Replies",
      "category": "theme",
      "icon": {
        "name": "fas fa-comments",
        "backgroundColor": "#FF4500",
        "color": "#fff"
      }
    }
  }
}
